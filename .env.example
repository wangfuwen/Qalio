# Reference only: the application does not automatically load .env.
# Set these variables in the server's shell, or explicitly use uvicorn --env-file .env.
QA_ENABLE_JEV=true
TYPESAFE_API_KEY=
QA_JEV_MODEL=jev-latest
QA_JEV_NEGATIVE_THRESHOLD=0.30
QA_JEV_POSITIVE_THRESHOLD=0.80
QA_JEV_EVIDENCE_CONFIDENCE=0.60
QA_ENABLE_LLM=false
OPENAI_API_KEY=
QA_MODEL=gpt-4o-mini
